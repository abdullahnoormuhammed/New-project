# Shared settings, so the committee can edit from a phone and every screen
# follows. Leave all three unset to run the board entirely on its own device.
#
# See INSTALL.md for where these come from. Both Supabase values are public by
# design — they end up inside the built website, and grant nothing on their own.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BOARD_SLUG=taqwa
